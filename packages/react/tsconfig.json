{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "paths": {
      "@fetch-doctor/core": ["../core/src/index.ts"],
      "@fetch-doctor/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
