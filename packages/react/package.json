{
  "name": "@fetch-doctor/react",
  "version": "0.0.1",
  "description": "React 19 lifecycle hooks & diagnostic observers for fetch-doctor.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "homepage": "https://fetch-doctor.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmy-lana/fetch-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/mmy-lana/fetch-doctor/issues"
  },
  "keywords": ["fetch-doctor", "react-19", "useTrackFetch", "zombie-fetch", "abortcontroller"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@fetch-doctor/shared": "workspace:*",
    "@fetch-doctor/core": "workspace:*",
    "react": "19.0.0-rc.1",
    "react-dom": "19.0.0-rc.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
