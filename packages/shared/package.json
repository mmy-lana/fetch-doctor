{
  "name": "@fetch-doctor/shared",
  "version": "0.0.4",
  "description": "Shared types, formatters, and utilities for fetch-doctor.",
  "homepage": "https://fetch-doctor.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmy-lana/fetch-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/mmy-lana/fetch-doctor/issues"
  },
  "keywords": [
    "fetch-doctor",
    "shared-types",
    "typescript",
    "zombie-fetch",
    "abortsignal"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "src/index.ts",
    "src/logo.svg",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
